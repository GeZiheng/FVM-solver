{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "build-and-test": {
      "type": "local",
        "command": [
          "python",
          ".agents/mcp/build_and_test_server.py"
        ],
      "enabled": true
    },
    "build-and-test-wsl": {
      "type": "local",
      "command": [
        "wsl.exe",
        "-e",
        "bash",
        "-lc",
        "exec python3 .agents/mcp/build_and_test_server.py"
      ],
      "enabled": true
    },
    "openfoam": {
      "type": "local",
      "command": [
        "python",
        ".agents/mcp/openfoam_server.py"
      ],
      "enabled": true,
      "timeout": 300000
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "cmake --build *", "effect": "deny" },
    { "action": "shell", "resource": "cmake -B *", "effect": "deny" },
    { "action": "shell", "resource": "cmake -S *", "effect": "deny" },
    { "action": "shell", "resource": "ctest *", "effect": "deny" },
    { "action": "shell", "resource": "ninja *", "effect": "deny" },
    { "action": "shell", "resource": "*fvm_tests*", "effect": "deny" },
    { "action": "openfoam_run_case", "resource": "*", "effect": "ask" }
  ]
}
