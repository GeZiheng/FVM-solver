{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "build-and-test": {
      "type": "local",
        "command": [
          "python",
          ".agents/mcp/build_and_test_server.py"
        ],
      "enabled": true
    },
    "build-and-test-wsl": {
      "type": "local",
      "command": [
        "wsl.exe",
        "-e",
        "bash",
        "-lc",
        "exec python3 .agents/mcp/build_and_test_server.py"
      ],
      "enabled": true
    },
    "openfoam": {
      "type": "local",
      "command": [
        "python",
        ".agents/mcp/openfoam_server.py"
      ],
      "enabled": true,
      "timeout": 300000
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "cmake --build *": "deny",
      "cmake -B *": "deny",
      "cmake -S *": "deny",
      "ctest *": "deny",
      "ninja *": "deny",
      "*fvm_tests*": "deny"
    }
  }
}
