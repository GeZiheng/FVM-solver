{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "build-and-test": {
      "type": "local",
        "command": [
          "python",
          ".agents/mcp/build_and_test_server.py"
        ],
      "environment": { "VCPKG_ROOT": "D:/Projects/vcpkg" },
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "cmake --build *": "deny",
      "cmake -B *": "deny",
      "cmake -S *": "deny",
      "ctest *": "deny",
      "ninja *": "deny",
      "*fvm_tests*": "deny"
    }
  }
}
